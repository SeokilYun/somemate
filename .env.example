# 서버에 직접 구성된 MySQL 인스턴스 접속 정보로 채운다 (로컬 컨테이너 없음).
DATABASE_URL="mysql://user:password@서버주소:3306/somemate"

# NextAuth 세션 암호화 시크릿. 생성: openssl rand -base64 32
NEXTAUTH_SECRET=""

# NextAuth 콜백 기준 URL (로컬: http://localhost:3000)
NEXTAUTH_URL=""

# 네이티브 앱 전용 액세스 토큰(Bearer) 서명 시크릿. NEXTAUTH_SECRET과 별개로 관리. 생성: openssl rand -base64 32
MOBILE_JWT_SECRET=""

# 소셜 로그인 — 값이 없으면 해당 provider는 자동으로 비활성화된다(에러 안 남, credentials만 유지).
# Google: https://console.cloud.google.com → OAuth 클라이언트 ID, 승인된 리디렉션 URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Kakao: https://developers.kakao.com → 내 애플리케이션 → 카카오 로그인 활성화, Redirect URI: {NEXTAUTH_URL}/api/auth/callback/kakao
# (이메일을 받으려면 "카카오 로그인 > 동의항목"에서 이메일을 활성화하고, 필요 시 비즈니스 앱 전환/심사가 있어야 함.
#  이메일을 못 받으면 kakao_{id}@kakao.somemate.local 형태의 임시 이메일로 계정이 생성된다.)
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
# Apple: https://developer.apple.com (유료 개발자 계정 필요) → Sign in with Apple용 Service ID/Key 발급
#   APPLE_CLIENT_ID: Service ID (예: com.somemate.web)
#   APPLE_TEAM_ID: Apple Developer 계정의 Team ID
#   APPLE_KEY_ID: 발급받은 Key(.p8)의 Key ID
#   APPLE_PRIVATE_KEY: 그 .p8 파일 내용 그대로, 줄바꿈은 \n으로 이스케이프해서 한 줄로
#   Return URL: {NEXTAUTH_URL}/api/auth/callback/apple
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# 이미지 분석 및 캐릭터 응답 생성에 사용하는 비전 지원 LLM API 키 (제공사 미정, 서버 전용, 클라이언트 노출 금지)
LLM_API_KEY=""

# Web Push 발송용 키 쌍. 생성: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# 후속 알림 발송 내부 엔드포인트(/api/internal/followups/dispatch) 인증용, 임의의 랜덤 문자열
CRON_SECRET=""
