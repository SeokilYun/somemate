// Prisma 스키마 — 데이터 모델은 AGENTS.md "데이터 모델 (Prisma 개요)" 절과 반드시 일치시킨다.
// 필드를 추가/변경할 때는 AGENTS.md도 함께 갱신한다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Relationship {
  some
  dating
  coworker
  friend
  parent
  other
}

enum MessageRole {
  user
  positive
  cautious
  negative
  system
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // 소셜 로그인 전용 계정은 비밀번호가 없다 — 이메일/비밀번호 가입 사용자만 값이 채워진다.
  passwordHash String?
  createdAt    DateTime @default(now())

  partners          Partner[]
  conversations     Conversation[]
  pushSubscriptions PushSubscription[]
  accounts          Account[]

  @@map("users")
}

/** 소셜 로그인(구글/카카오/애플) 연결 정보. NextAuth 표준 스키마를 참고하되, 이 프로젝트는
 * PrismaAdapter 없이 src/lib/auth.ts의 signIn 콜백에서 직접 조회/생성한다(세션은 JWT 전략 사용). */
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Partner {
  id                 String       @id @default(cuid())
  userId             String
  name               String
  age                Int?
  mbti               String?
  interests          Json         @default("[]")
  relationship       Relationship
  relationshipCustom String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([userId])
  @@map("partners")
}

model Conversation {
  id                  String    @id @default(cuid())
  userId              String
  partnerId           String
  createdAt           DateTime  @default(now())
  lastMessageAt       DateTime?
  firstAnalysisAt     DateTime?
  followupScheduledAt DateTime?
  followupSentAt      DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner  Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, lastMessageAt])
  @@index([partnerId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String?     @db.Text
  imageUrls      Json        @default("[]")
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
